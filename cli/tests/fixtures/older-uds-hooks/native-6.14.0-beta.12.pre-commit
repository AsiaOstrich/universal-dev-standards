#!/bin/sh
# UDS pre-commit hook
# Auto-generated by uds init

echo "Running UDS pre-commit checks..."

# Lint, when the language's linter is installed. A failing linter blocks the commit.
if [ -f pyproject.toml ] || [ -f requirements.txt ]; then
  if python -m ruff --version >/dev/null 2>&1; then
    python -m ruff check . || exit $?
  fi
elif [ -f go.mod ]; then
  if command -v go >/dev/null 2>&1; then
    go vet ./... || exit $?
  fi
elif [ -f Cargo.toml ]; then
  if command -v cargo >/dev/null 2>&1; then
    cargo clippy || exit $?
  fi
fi

# UDS Standard Check
# Runs the UDS CLI installed in this project (node_modules/.bin) or on PATH.
# It never asks npm to fetch anything: the short name "uds" on the npm registry
# belongs to an unrelated package, and npx would download and run it.
(
  PATH="$PWD/node_modules/.bin:$PATH"
  if command -v universal-dev-standards >/dev/null 2>&1; then
    universal-dev-standards check
    exit $?
  fi
  echo "[UDS] Pre-commit check cannot run: the UDS CLI (universal-dev-standards) is not installed." >&2
  echo "[UDS] Install it:  npm install --save-dev universal-dev-standards   (or: npm install -g universal-dev-standards)" >&2
  echo "[UDS] This commit is blocked until it is installed, or until you remove this block from .git/hooks/pre-commit." >&2
  exit 1
) || exit $?
# End UDS Standard Check

echo "Pre-commit checks passed"
